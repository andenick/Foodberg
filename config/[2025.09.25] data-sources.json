{
  "description": "Multi-source food commodity pricing data configuration",
  "last_updated": "2025-09-25",
  "priority_order": ["usda_mars", "usda_nass", "fao_food_prices", "world_bank_rtfp", "api_ninja_commodity", "scraped_data"],

  "sources": {
    "usda_mars": {
      "name": "USDA Market News API",
      "type": "api",
      "url": "https://marsapi.ams.usda.gov/services/v1.2",
      "description": "Official USDA commodity market data - most authoritative source",
      "data_types": ["wholesale_prices", "market_reports", "trading_volumes"],
      "update_frequency": "real-time",
      "cost": "free",
      "api_key_required": true,
      "api_key_field": "usda_mars_api_key",
      "rate_limit": "100000_records_per_request",
      "commodities": ["wheat", "corn", "soybeans", "cattle", "hogs", "milk", "cotton", "coffee"],
      "reliability": "highest",
      "data_quality": "official_government"
    },

    "usda_nass": {
      "name": "USDA NASS QuickStats API",
      "type": "api",
      "url": "https://quickstats.nass.usda.gov/api",
      "description": "Free USDA National Agricultural Statistics Service data",
      "data_types": ["agricultural_statistics", "production_data", "price_data"],
      "update_frequency": "monthly",
      "cost": "free",
      "api_key_required": true,
      "api_key_field": "usda_nass_api_key",
      "rate_limit": "no_limit_mentioned",
      "commodities": ["wheat", "corn", "soybeans", "cattle", "hogs", "milk", "rice", "cotton"],
      "reliability": "highest",
      "data_quality": "official_government"
    },

    "fao_food_prices": {
      "name": "FAO Food Price Index",
      "type": "download",
      "url": "https://www.fao.org/faostat/en/",
      "description": "UN FAO free food price indices and statistics",
      "data_types": ["price_indices", "historical_data", "global_statistics"],
      "update_frequency": "monthly",
      "cost": "free",
      "api_key_required": false,
      "commodities": ["cereals", "meat", "dairy", "oils", "sugar"],
      "reliability": "highest",
      "data_quality": "official_un_organization"
    },

    "world_bank_rtfp": {
      "name": "World Bank Real Time Food Prices",
      "type": "download",
      "url": "https://microdata.worldbank.org/index.php/catalog/4483",
      "description": "Free World Bank real-time food price estimates",
      "data_types": ["monthly_price_estimates", "market_data", "country_specific"],
      "update_frequency": "weekly",
      "cost": "free",
      "api_key_required": false,
      "commodities": ["rice", "wheat", "maize", "beans", "meat", "milk"],
      "reliability": "highest",
      "data_quality": "official_world_bank"
    },

    "world_bank": {
      "name": "World Bank Pink Sheet",
      "type": "api_and_download",
      "url": "https://databank.worldbank.org/databases/commodity-price-data",
      "description": "Monthly official commodity price data and forecasts",
      "data_types": ["monthly_prices", "historical_data", "price_forecasts"],
      "update_frequency": "monthly",
      "cost": "free",
      "api_key_required": false,
      "commodities": ["rice", "wheat", "coffee", "corn", "sugar", "palm_oil", "soybeans"],
      "reliability": "highest",
      "data_quality": "official_international_organization"
    },

    "imf_commodity": {
      "name": "IMF Primary Commodity Prices",
      "type": "download",
      "url": "https://www.imf.org/en/Research/commodity-prices",
      "description": "IMF primary commodity price data - monthly updates",
      "data_types": ["monthly_prices", "historical_data"],
      "update_frequency": "monthly",
      "cost": "free",
      "api_key_required": false,
      "commodities": ["agricultural_commodities", "metals", "energy"],
      "reliability": "highest",
      "data_quality": "official_imf"
    },

    "grocery_retail_apis": {
      "name": "Grocery Store APIs",
      "type": "scraping_api",
      "description": "Retail food prices from major grocery chains",
      "data_types": ["retail_prices", "store_locations", "product_availability"],
      "update_frequency": "daily",
      "cost": "varies",
      "api_key_required": true,
      "targets": {
        "walmart": {"url": "https://developer.walmart.com/api/", "api_key_field": "walmart_api_key"},
        "kroger": {"url": "https://www.kroger.com/api/", "api_key_field": "kroger_api_key"},
        "target": {"url": "https://api.target.com/", "api_key_field": "target_api_key"}
      },
      "reliability": "medium",
      "data_quality": "retail_consumer_facing"
    },

    "agricultural_exchanges": {
      "name": "Agricultural Commodity Exchanges",
      "type": "scraping",
      "description": "Direct commodity exchange data",
      "data_types": ["futures_prices", "spot_prices", "trading_volumes"],
      "update_frequency": "real-time_trading_hours",
      "cost": "free_for_delayed_data",
      "targets": {
        "cme_group": {"url": "https://www.cmegroup.com/", "delay": "15_minutes"},
        "ice_futures": {"url": "https://www.theice.com/", "delay": "15_minutes"}
      },
      "reliability": "high",
      "data_quality": "exchange_official"
    },

    "api_ninja_commodity": {
      "name": "API Ninja Commodity Prices",
      "type": "api",
      "url": "https://api.api-ninjas.com/v1/commodityprice",
      "description": "Real-time commodity prices from major exchanges",
      "data_types": ["current_prices", "exchange_data"],
      "update_frequency": "real-time",
      "cost": "freemium",
      "api_key_required": true,
      "api_key_field": "api_ninja_key",
      "rate_limit": "10000_requests_per_month_free",
      "commodities": ["cme_nymex_commodities"],
      "reliability": "medium",
      "data_quality": "exchange_aggregated"
    }
  },

  "data_collection_strategy": {
    "fallback_order": [
      "usda_mars",
      "commodities_api",
      "world_bank",
      "twelve_data",
      "api_ninja_commodity",
      "agricultural_exchanges",
      "grocery_retail_apis"
    ],
    "cache_duration": {
      "real_time": "5_minutes",
      "daily": "1_hour",
      "weekly": "6_hours",
      "monthly": "24_hours"
    },
    "backup_storage": {
      "local_files": true,
      "database": true,
      "cloud_backup": false
    }
  },

  "commodity_mapping": {
    "wheat": ["wheat", "WHEAT", "W1", "wheat_hard_red_winter"],
    "corn": ["corn", "CORN", "C1", "corn_yellow"],
    "soybeans": ["soybeans", "SOYBEAN", "S1", "soybean"],
    "rice": ["rice", "RICE", "RR1", "rice_long_grain"],
    "coffee": ["coffee", "COFFEE", "KC1", "coffee_arabica"],
    "sugar": ["sugar", "SUGAR", "SB1", "sugar_raw"],
    "cattle": ["cattle", "CATTLE", "LC1", "live_cattle"],
    "hogs": ["hogs", "HOGS", "LH1", "lean_hogs"],
    "milk": ["milk", "MILK", "DA1", "class_iii_milk"],
    "butter": ["butter", "BUTTER", "BU1", "grade_aa_butter"],
    "cheese": ["cheese", "CHEESE", "CH1", "cheddar_cheese"],
    "eggs": ["eggs", "EGGS", "EG1", "large_eggs"],
    "chicken": ["chicken", "CHICKEN", "poultry", "chicken_breast"],
    "beef": ["beef", "BEEF", "beef_brisket", "ground_beef"],
    "pork": ["pork", "PORK", "pork_loin", "pork_bellies"]
  },

  "data_validation": {
    "price_range_checks": true,
    "outlier_detection": true,
    "source_comparison": true,
    "historical_trend_validation": true,
    "minimum_sources_for_confidence": 2
  },

  "storage_structure": {
    "raw_data_path": "data/raw_sources/",
    "processed_data_path": "data/processed/",
    "historical_data_path": "data/historical/",
    "cache_path": "data/cache/",
    "backup_path": "data/backups/"
  }
}