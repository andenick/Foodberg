{
  "$schema": "https://railway.app/railway.schema.json",
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  },
  "environments": {
    "production": {
      "variables": {
        "NODE_ENV": "production",
        "PORT": "3001",
        "CORS_ORIGIN": "https://foodberg.org"
      }
    }
  },
  "services": {
    "foodberg-backend": {
      "source": {
        "repo": "your-repo/foodberg",
        "rootDirectory": "/server"
      },
      "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm install",
        "startCommand": "npm start"
      },
      "deploy": {
        "healthcheckPath": "/api/health",
        "healthcheckTimeout": 100,
        "restartPolicyType": "ON_FAILURE"
      }
    }
  }
}