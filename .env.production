# Foodberg Production Environment Configuration
# Domain: foodberg.org

# API Configuration
NEXT_PUBLIC_API_URL=https://api.foodberg.org
NEXT_PUBLIC_SITE_URL=https://foodberg.org

# USDA API Configuration
USDA_API_KEY=your_usda_api_key_here
USDA_BASE_URL=https://mymarketnews.ams.usda.gov/api

# Application Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Foodberg
NEXT_PUBLIC_APP_VERSION=1.0.0

# Analytics and Monitoring (Optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id
VERCEL_ANALYTICS_ID=your_vercel_analytics_id

# Database Configuration (if using external DB)
DATABASE_URL=your_database_connection_string

# Security
NEXTAUTH_URL=https://foodberg.org
NEXTAUTH_SECRET=your_nextauth_secret_here

# Performance
NEXT_PUBLIC_ENABLE_CACHE=true
NEXT_PUBLIC_CACHE_TTL=300

# Features
NEXT_PUBLIC_ENABLE_REAL_TIME_DATA=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true