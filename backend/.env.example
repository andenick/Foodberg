# Foodberg Backend Environment Variables
# Copy to .env for local development or set in deployment platform

# Server Configuration
ENV=development
PORT=8000
HOST=0.0.0.0

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# API Keys (required for data collection)
# Get from: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your_fred_api_key_here

# Get from: https://data.bls.gov/registrationEngine/
BLS_API_KEY=your_bls_api_key_here

# USDA AMS Market News API (for terminal market prices)
# Get from: https://mymarketnews.ams.usda.gov/ (register for API access)
# NOTE: This is a DIFFERENT key from USDA NASS Quick Stats.
# WASDE data comes from Robin's offline files, not this API.
USDA_AMS_API_KEY=your_usda_ams_market_news_key_here

# USDA NASS Quick Stats API (not used at runtime; Robin provides WASDE data offline)
# Get from: https://quickstats.nass.usda.gov/api
# USDA_NASS_API_KEY=your_usda_nass_key_here

# Optional: BEA API for additional economic data
# Get from: https://apps.bea.gov/API/signup/
BEA_API_KEY=your_bea_api_key_here

# Database (SQLite by default, can be overridden for PostgreSQL)
# DATABASE_URL=sqlite:///data/foodberg.db
# DATABASE_URL=postgresql://user:pass@host:5432/foodberg

# Logging
LOG_LEVEL=INFO
